# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly LF for source and config files
*.java       text eol=lf
*.kt         text eol=lf
*.kts        text eol=lf
*.toml       text eol=lf
*.properties text eol=lf
*.xml        text eol=lf
*.json       text eol=lf
*.html       text eol=lf
*.css        text eol=lf
*.js         text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.sh         text eol=lf

# Windows scripts keep CRLF
*.bat        text eol=crlf
*.cmd        text eol=crlf

# Binary files — no line ending conversion
*.jar        binary
*.png        binary
*.jpg        binary
*.gif        binary
*.ico        binary
*.zip        binary
